<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PatMaxSharp</AssemblyName>
    <RootNamespace>PatMaxSharp</RootNamespace>
  </PropertyGroup>

  <!-- The WPF UI is a separate project; do not compile its sources here -->
  <ItemGroup>
    <Compile Remove="PatMaxSharp.UI\**" />
    <None Remove="PatMaxSharp.UI\**" />
  </ItemGroup>

</Project>
