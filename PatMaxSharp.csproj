<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PatMaxSharp</AssemblyName>
    <RootNamespace>PatMaxSharp</RootNamespace>
  </PropertyGroup>

  <!-- The WPF UI is a separate project; do not compile its sources here.
       tools/ holds standalone analyser projects with their own obj/bin output. -->
  <ItemGroup>
    <Compile Remove="PatMaxSharp.UI\**" />
    <Compile Remove="PatMaxSharp.CalTest\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="docs\**" />
    <None Remove="PatMaxSharp.UI\**" />
    <None Remove="PatMaxSharp.CalTest\**" />
    <None Remove="tools\**" />
    <None Remove="docs\**" />
  </ItemGroup>

</Project>
