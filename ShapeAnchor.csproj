<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ShapeAnchor</AssemblyName>
    <RootNamespace>ShapeAnchor</RootNamespace>
  </PropertyGroup>

  <!-- The WPF UI is a separate project; do not compile its sources here.
       tools/ holds standalone analyser projects with their own obj/bin output. -->
  <ItemGroup>
    <Compile Remove="ShapeAnchor.UI\**" />
    <Compile Remove="ShapeAnchor.Controls\**" />
    <Compile Remove="ShapeAnchor.CalTest\**" />
    <Compile Remove="tools\**" />
    <Compile Remove="docs\**" />
    <Compile Remove="**\obj\**\*.cs" />
    <Compile Remove="**\bin\**\*.cs" />
    <None Remove="ShapeAnchor.UI\**" />
    <None Remove="ShapeAnchor.Controls\**" />
    <None Remove="ShapeAnchor.CalTest\**" />
    <None Remove="tools\**" />
    <None Remove="docs\**" />
  </ItemGroup>

</Project>
