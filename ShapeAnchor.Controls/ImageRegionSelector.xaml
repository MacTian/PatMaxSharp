<UserControl x:Class="ShapeAnchor.Controls.ImageRegionSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black">
    <!-- The bitmap is the canvas background, not a child element, so canvas coordinates ARE
         image pixels: no offset, no letterbox, no element-vs-content mismatch. Children
         (region rectangles, markers, overlay) are positioned in image pixels directly. -->
    <ScrollViewer x:Name="scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="Black"
                  HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
        <Canvas x:Name="canvas"
                MouseLeftButtonDown="OnMouseDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseUp"
                MouseWheel="OnMouseWheel">
            <Canvas.Background>
                <ImageBrush Stretch="Fill"/>
            </Canvas.Background>
        </Canvas>
    </ScrollViewer>
</UserControl>
