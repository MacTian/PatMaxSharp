<Window x:Class="PatMaxSharp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PatMaxSharp.UI.Controls"
        Title="PatMaxSharp — Cognex PatMax 算法复现" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="#EEE"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="lbl">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#1E1E1E">
        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="#2D2D30">
            <ToolBar Background="#2D2D30" Foreground="#EEE">
                <Button Content="打开图片" Command="{Binding OpenImageCommand}"/>
                <Separator/>
                <Button Content="训练模型" Command="{Binding TrainCommand}"/>
                <Button Content="运行匹配" Command="{Binding RunCommand}"/>
                <Separator/>
                <Button Content="清空" Command="{Binding ClearCommand}"/>
                <Separator/>
                <TextBlock Text="状态:" Style="{StaticResource lbl}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding Status}" Foreground="#4FC3F7" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#2D2D30">
            <StatusBarItem>
                <TextBlock Text="{Binding ImagePixelWidth, StringFormat='宽度: {0}px'}" Foreground="#CCC"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ImagePixelHeight, StringFormat='高度: {0}px'}" Foreground="#CCC"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="#CCC"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Parameters panel -->
            <ScrollViewer Grid.Column="0" Background="#252526" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Region selection -->
                    <GroupBox Header="1. 区域选择（在图片上拖拽）">
                        <StackPanel>
                            <TextBlock Text="训练区域 (绿色)" Foreground="#7CFC00" Margin="2"/>
                            <TextBlock Text="{Binding TrainRegion}" Foreground="#CCC" FontSize="11"/>
                            <TextBlock Text="搜索区域 (青色)" Foreground="#00FFFF" Margin="2,6,2,0"/>
                            <TextBlock Text="{Binding SearchRegion}" Foreground="#CCC" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="rbTrain" Content="选择训练区" Foreground="#CCC" IsChecked="True" Margin="2"/>
                                <RadioButton x:Name="rbSearch" Content="选择搜索区" Foreground="#CCC" Margin="2"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Search parameters -->
                    <GroupBox Header="2. 查找参数">
                        <StackPanel>
                            <TextBlock Text="搜索范围 (搜索区域大小)" Style="{StaticResource lbl}"/>
                            <TextBlock Text="搜索区域覆盖整幅图，可在图片上框选限定范围" Foreground="#888" FontSize="11" Margin="2,0,0,6"/>

                            <TextBlock Text="{Binding RotationAngleMin, StringFormat='旋转最小: {0:F0}°'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="-180" Maximum="0" Value="{Binding RotationAngleMin}" TickFrequency="5"/>
                            <TextBlock Text="{Binding RotationAngleMax, StringFormat='旋转最大: {0:F0}°'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="0" Maximum="180" Value="{Binding RotationAngleMax}" TickFrequency="5"/>

                            <TextBlock Text="{Binding ScaleMin, StringFormat='缩放最小: {0:F2}x'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="0.5" Maximum="1.0" Value="{Binding ScaleMin}" TickFrequency="0.01"/>
                            <TextBlock Text="{Binding ScaleMax, StringFormat='缩放最大: {0:F2}x'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1.0" Maximum="2.0" Value="{Binding ScaleMax}" TickFrequency="0.01"/>

                            <TextBlock Text="{Binding ApproximateNumberToFind, StringFormat='预期数量: {0}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1" Maximum="20" Value="{Binding ApproximateNumberToFind}" TickFrequency="1"/>

                            <TextBlock Text="{Binding XYOverlap, StringFormat='XY 重叠: {0:F2}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding XYOverlap}" TickFrequency="0.05"/>

                            <TextBlock Text="{Binding TimeoutMs, StringFormat='超时: {0:F0} ms'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="100" Maximum="30000" Value="{Binding TimeoutMs}" TickFrequency="500"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Scoring parameters -->
                    <GroupBox Header="3. 评分参数">
                        <StackPanel>
                            <TextBlock Text="{Binding AcceptThreshold, StringFormat='接受阈值: {0:F2}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding AcceptThreshold}" TickFrequency="0.01"/>

                            <TextBlock Text="{Binding ContrastThreshold, StringFormat='对比度阈值: {0:F2}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding ContrastThreshold}" TickFrequency="0.01"/>

                            <TextBlock Text="{Binding Grain, StringFormat='粒度 (grain): {0:F1}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1" Maximum="25.5" Value="{Binding Grain}" TickFrequency="0.5"/>

                            <TextBlock Text="{Binding CoarseGrainLimit, StringFormat='粗匹配粒度: {0}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1" Maximum="25" Value="{Binding CoarseGrainLimit}" TickFrequency="1"/>

                            <TextBlock Text="{Binding FineGrainLimit, StringFormat='精匹配粒度: {0}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1" Maximum="25" Value="{Binding FineGrainLimit}" TickFrequency="1"/>

                            <CheckBox Content="使用杂波评分 (ScoreUsingClutter)" IsChecked="{Binding ScoreUsingClutter}"/>
                            <TextBlock Text="{Binding MaxResults, StringFormat='最大结果数: {0}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1" Maximum="50" Value="{Binding MaxResults}" TickFrequency="1"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Performance parameters -->
                    <GroupBox Header="4. 性能 / 精度">
                        <StackPanel>
                            <TextBlock Text="{Binding PrecisionStep, StringFormat='累加器步长: {0} px'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="1" Maximum="8" Value="{Binding PrecisionStep}" TickFrequency="1"/>
                            <CheckBox Content="亚像素细化" IsChecked="{Binding SubpixelRefinement}"/>
                            <CheckBox Content="候选聚类" IsChecked="{Binding EnableClustering}"/>
                            <TextBlock Text="{Binding ClusterRadius, StringFormat='聚类半径: {0:F0} px'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="2" Maximum="40" Value="{Binding ClusterRadius}" TickFrequency="2"/>
                            <TextBlock Text="{Binding PreSmoothSigma, StringFormat='高斯预平滑 σ: {0:F1}'}" Style="{StaticResource lbl}"/>
                            <Slider Minimum="0" Maximum="3" Value="{Binding PreSmoothSigma}" TickFrequency="0.1"/>
                            <CheckBox Content="SIMD 加速" IsChecked="{Binding UseSimd}"/>
                            <CheckBox Content="并行处理" IsChecked="{Binding UseParallel}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Image + results -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Image viewer -->
                <Border Grid.Row="0" Background="#111" Margin="4" ClipToBounds="True">
                    <c:ImageRegionSelector x:Name="viewer"
                        Source="{Binding Image}"
                        TrainRegion="{Binding TrainRegion, Mode=TwoWay}"
                        SearchRegion="{Binding SearchRegion, Mode=TwoWay}"
                        ImageWidth="{Binding ImagePixelWidth}"
                        ImageHeight="{Binding ImagePixelHeight}"/>
                </Border>

                <!-- Results -->
                <GroupBox Grid.Row="1" Header="匹配结果">
                    <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" Background="#1E1E1E" Foreground="#EEE"
                              RowBackground="#252526" AlternatingRowBackground="#2D2D30"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" Width="40"/>
                            <DataGridTextColumn Header="得分 Score" Binding="{Binding Score, StringFormat=F3}" Width="90"/>
                            <DataGridTextColumn Header="相似度 Coverage" Binding="{Binding Coverage, StringFormat=P0}" Width="100"/>
                            <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}" Width="70"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}" Width="70"/>
                            <DataGridTextColumn Header="角度 Angle" Binding="{Binding Angle, StringFormat=F2}" Width="90"/>
                            <DataGridTextColumn Header="缩放 Scale" Binding="{Binding Scale, StringFormat=F3}" Width="90"/>
                            <DataGridTextColumn Header="匹配特征" Binding="{Binding MatchedFeatures}" Width="90"/>
                            <DataGridTextColumn Header="杂波特征" Binding="{Binding BadFeatures}" Width="90"/>
                            <DataGridTextColumn Header="峰值" Binding="{Binding PeakValue, StringFormat=F1}" Width="70"/>
                            <DataGridCheckBoxColumn Header="接受" Binding="{Binding Accepted}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
