<Window x:Class="ShapeAnchor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ShapeAnchor.Controls;assembly=ShapeAnchor.Controls"
        xmlns:local="clr-namespace:ShapeAnchor.UI"
        Title="ShapeAnchor — 几何特征匹配引擎" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1D" Foreground="#E8E8E8"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12">

    <!-- ================= Dark theme =================
         Every control below sets both Background and Foreground, so no state can end up
         dark-on-dark or light-on-light. Palette:
           window   #1B1B1D    panel #232326    control #2E2E33    border #3E3E45
           text     #E8E8E8    secondary #A8A8B0    accent #4FC3F7    ok #7BD88F  warn #FFB454
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="BWindow"  Color="#1B1B1D"/>
        <SolidColorBrush x:Key="BPanel"   Color="#232326"/>
        <SolidColorBrush x:Key="BControl" Color="#2E2E33"/>
        <SolidColorBrush x:Key="BBorder"  Color="#3E3E45"/>
        <SolidColorBrush x:Key="BText"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="BSub"     Color="#A8A8B0"/>
        <SolidColorBrush x:Key="BAccent"  Color="#4FC3F7"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>

        <!-- text -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="lbl">
            <Setter Property="Foreground" Value="{StaticResource BSub}"/>
            <Setter Property="Margin" Value="2,4,2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="hint">
            <Setter Property="Foreground" Value="{StaticResource BSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,0,2,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="value">
            <Setter Property="Foreground" Value="{StaticResource BAccent}"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0,2,2"/>
        </Style>

        <!-- button: explicit states so hover/pressed never loses the text -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Background" Value="{StaticResource BControl}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C44"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5A5A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F6F8B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A3A42"/>
                                <Setter Property="Foreground" Value="#8C8C96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="primary">
            <Setter Property="Foreground" Value="#08161C"/>
            <Setter Property="Background" Value="{StaticResource BAccent}"/>
            <Setter Property="BorderBrush" Value="#2F9EC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#7FD6FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2F9EC8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A30"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A3A42"/>
                                <Setter Property="Foreground" Value="#8C8C96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- expander: dark header, light text, arrow tinted by the template border -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Background" Value="{StaticResource BControl}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <StackPanel>
                                <ToggleButton x:Name="tb" Focusable="False" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="8,6">
                                                <DockPanel>
                                                    <Path x:Name="arw" DockPanel.Dock="Left" Width="8" Height="8"
                                                          Margin="0,0,8,0" VerticalAlignment="Center"
                                                          Data="M 0 0 L 8 4 L 0 8 Z" Fill="{StaticResource BAccent}"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="arw" Property="Data" Value="M 0 0 L 8 0 L 4 8 Z"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="arw" Property="Fill" Value="#9BE0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                </ToggleButton>
                                <Border x:Name="body" Padding="8,2,8,8" Visibility="Collapsed">
                                    <ContentPresenter/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource BText}" FontWeight="SemiBold" FontSize="12"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- slider: visible track and accent thumb -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="2,0,2,6"/>
            <Setter Property="Foreground" Value="{StaticResource BAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="22">
                            <Border Height="4" CornerRadius="2" Background="#3E3E45" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource BAccent}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E8E8E8" BorderBrush="#1B1B1D" BorderThickness="1" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- check / radio: explicit colours for box and text in every state -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Margin" Value="2,4,2,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Margin" Value="2,4,10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BText}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <!-- combo box: dark field AND dark drop-down; the default popup is white, which made
             the light item text invisible -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Background" Value="{StaticResource BControl}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3C3C44"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F6F8B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="Background" Value="{StaticResource BControl}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource BControl}" BorderBrush="{StaticResource BBorder}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Data="M 0 0 L 8 0 L 4 6 Z" Fill="{StaticResource BSub}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="sel" Margin="8,0,26,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{StaticResource BControl}" BorderBrush="{StaticResource BBorder}"
                                        BorderThickness="1" CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="RowBackground" Value="#26262A"/>
            <Setter Property="AlternatingRowBackground" Value="#2C2C31"/>
            <Setter Property="BorderBrush" Value="{StaticResource BBorder}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource BText}"/>
            <Setter Property="BorderBrush" Value="#33333A"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F6F8B"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#46464E"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenImageCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding TrainCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearCommand}"/>
    </Window.InputBindings>

    <DockPanel Background="{StaticResource BWindow}">

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BPanel}"
                BorderBrush="{StaticResource BBorder}" BorderThickness="0,0,0,1" Padding="6,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="打开图片 (Ctrl+O)" Command="{Binding OpenImageCommand}"/>
                    <Button Content="训练模型 (Ctrl+T)" Command="{Binding TrainCommand}"/>
                    <Button Content="运行匹配 (F5)" Command="{Binding RunCommand}" Style="{StaticResource primary}"/>
                    <Button Content="清空" Command="{Binding ClearCommand}"/>
                    <Separator/>
                    <Button Content="批量验证" Command="{Binding BatchValidateCommand}"
                            ToolTip="选一个文件夹：第一张训练，逐张搜索，每张一行结果"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource BAccent}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BPanel}"
                BorderBrush="{StaticResource BBorder}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding ParamsSummary}" Foreground="{StaticResource BSub}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ImagePixelWidth, StringFormat='{}{0}'}" Foreground="{StaticResource BSub}" FontSize="11"/>
                    <TextBlock Text=" × " Foreground="{StaticResource BSub}" FontSize="11"/>
                    <TextBlock Text="{Binding ImagePixelHeight}" Foreground="{StaticResource BSub}" FontSize="11"/>
                    <TextBlock Text=" px" Foreground="{StaticResource BSub}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="处理 " Foreground="{StaticResource BSub}" FontSize="11"/>
                    <TextBlock x:Name="timeText" Foreground="{StaticResource BAccent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=" ms   吞吐 " Foreground="{StaticResource BSub}" FontSize="11"/>
                    <TextBlock x:Name="tputText" Foreground="{StaticResource BAccent}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text=" Mpx/s   结果 " Foreground="{StaticResource BSub}" FontSize="11"/>
                    <TextBlock Text="{Binding Results.Count}" Foreground="{StaticResource BAccent}" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Parameter panel ===== -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource BPanel}">
                    <StackPanel Margin="4,6,6,10">

                        <Expander Header="1. 区域与掩膜" IsExpanded="True">
                            <StackPanel>
                                <TextBlock Text="训练区域（绿）" Foreground="#7BD88F" FontWeight="SemiBold" Margin="2,0,0,0"/>
                                <TextBlock Text="{Binding TrainRegionText}" Style="{StaticResource value}"/>
                                <TextBlock Text="搜索区域（青）" Foreground="#4FD3D3" FontWeight="SemiBold" Margin="2,6,0,0"/>
                                <TextBlock Text="{Binding SearchRegionText}" Style="{StaticResource value}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="rbTrain" Content="训练区" IsChecked="True"/>
                                    <RadioButton x:Name="rbSearch" Content="搜索区"/>
                                    <RadioButton x:Name="rbMask" Content="涂抹掩膜"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource hint}" Margin="2,6,2,0"
                                           Text="拖动框选；滚轮缩放。掩膜 = 原版 Care / Don't Care：红色区域不参与训练与评分。"/>

                                <Border Background="#1F1F23" BorderBrush="{StaticResource BBorder}" BorderThickness="1"
                                        CornerRadius="3" Padding="6" Margin="2,8,2,0">
                                    <StackPanel>
                                        <CheckBox Content="启用掩膜（训练 + 运行）" IsChecked="{Binding UseMask}"/>
                                        <TextBlock Text="{Binding MaskSummary}" Style="{StaticResource hint}"/>
                                        <TextBlock Text="{Binding BrushRadius, StringFormat='笔刷半径：{0:F0} px'}"
                                                   Style="{StaticResource lbl}"/>
                                        <Slider Minimum="2" Maximum="60" Value="{Binding BrushRadius}" TickFrequency="2"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="擦除（标为 Don't care）" IsChecked="{Binding MaskErase}"
                                                      ToolTip="勾选=涂抹区域被忽略；取消=涂抹区域恢复参与"/>
                                            <Button Content="清空" Command="{Binding ClearMaskCommand}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="被掩特征计分方式" Style="{StaticResource lbl}"/>
                                        <ComboBox SelectedIndex="{Binding MaskScoringIndex}">
                                            <ComboBoxItem Content="不计分 DoNotScoreFeatures"/>
                                            <ComboBoxItem Content="记为杂波 ScoreFeaturesAsClutter"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <Expander Header="2. 训练">
                            <StackPanel>
                                <TextBlock Style="{StaticResource hint}"
                                           Text="结果里的 (X, Y) 就是这个原点在图像中的位置。缺省取训练区中心。"/>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="原点 X" Style="{StaticResource lbl}"/>
                                    <TextBox Grid.Column="1" Margin="2"
                                             Text="{Binding OriginX, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="原点 Y" Style="{StaticResource lbl}"/>
                                    <TextBox Grid.Column="1" Margin="2"
                                             Text="{Binding OriginY, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <CheckBox Content="跟随训练区中心" IsChecked="{Binding OriginFollowsCenter}"/>
                                    <Button Content="中心原点" Command="{Binding CenterOriginCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource value}" Text="{Binding OriginText}" Margin="2,4,0,0"/>

                                <Separator Margin="2,8,2,4"/>
                                <CheckBox Content="忽略极性 IgnorePolarity" IsChecked="{Binding IgnorePolarity}"
                                          ToolTip="反光、剪影场景需要；会降低区分力"/>
                                <CheckBox Content="自动边缘阈值 AutoEdgeThreshold" IsChecked="{Binding AutoEdgeThreshold}"
                                          ToolTip="按图像梯度分布自动定门限，欠曝帧才下调"/>
                                <TextBlock Text="{Binding EdgeThreshold, StringFormat='边缘阈值：{0:F1}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="60" Value="{Binding EdgeThreshold}" TickFrequency="1"/>
                                <TextBlock Text="{Binding Grain, StringFormat='粒度 Grain：{0:F1}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="10" Value="{Binding Grain}" TickFrequency="0.5"/>
                                <TextBlock Text="{Binding TrainMaxFeatures, StringFormat='特征数上限：{0}（越小越抗光照变化）'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="40" Maximum="600" Value="{Binding TrainMaxFeatures}" TickFrequency="10"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="3. 查找">
                            <StackPanel>
                                <TextBlock Style="{StaticResource hint}"
                                           Text="区间越窄越快；缩放区间过宽会引入『缩小副本』退化解。"/>
                                <TextBlock Text="{Binding RotationAngleMin, StringFormat='旋转最小：{0:F0}°'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="-180" Maximum="0" Value="{Binding RotationAngleMin}" TickFrequency="5"/>
                                <TextBlock Text="{Binding RotationAngleMax, StringFormat='旋转最大：{0:F0}°'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="180" Value="{Binding RotationAngleMax}" TickFrequency="5"/>
                                <TextBlock Text="{Binding ScaleMin, StringFormat='缩放最小：{0:F2}×'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="0.4" Maximum="1.0" Value="{Binding ScaleMin}" TickFrequency="0.01"/>
                                <TextBlock Text="{Binding ScaleMax, StringFormat='缩放最大：{0:F2}×'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="1.0" Maximum="2.0" Value="{Binding ScaleMax}" TickFrequency="0.01"/>
                                <TextBlock Text="{Binding ApproximateNumberToFind, StringFormat='预期数量：{0}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="20" Value="{Binding ApproximateNumberToFind}" TickFrequency="1"/>
                                <TextBlock Text="{Binding XYOverlap, StringFormat='XY 重叠：{0:F2}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding XYOverlap}" TickFrequency="0.05"/>
                                <TextBlock Text="{Binding TimeoutText}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="100" Maximum="30000" Value="{Binding TimeoutMs}" TickFrequency="500"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="4. 评分">
                            <StackPanel>
                                <TextBlock Text="{Binding AcceptThreshold, StringFormat='接受阈值：{0:F2}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding AcceptThreshold}" TickFrequency="0.01"/>
                                <TextBlock Style="{StaticResource hint}" Text="0.70 为生产建议值：低于它的结果不会出现在表格里。"/>
                                <TextBlock Text="{Binding MinPolarityCoherence, StringFormat='极性一致性门：{0:F2}'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding MinPolarityCoherence}" TickFrequency="0.05"/>
                                <TextBlock Style="{StaticResource hint}"
                                           Text="真实实例≈1.00，边缘密度相似的伪解≈0.5；忽略极性时建议 0.75。"/>
                                <TextBlock Text="{Binding ContrastThreshold, StringFormat='对比度阈值：{0:F2}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding ContrastThreshold}" TickFrequency="0.01"/>
                                <CheckBox Content="杂波计入评分 ScoreUsingClutter" IsChecked="{Binding ScoreUsingClutter}"/>
                                <TextBlock Text="{Binding ScoreExponentN, StringFormat='评分指数 N：{0:F1}（越小越严）'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="4" Value="{Binding ScoreExponentN}" TickFrequency="0.5"/>
                                <TextBlock Text="{Binding MaxResults, StringFormat='最大结果数：{0}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="50" Value="{Binding MaxResults}" TickFrequency="1"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="5. 高级（一般不需要改）">
                            <StackPanel>
                                <TextBlock Text="{Binding PrecisionStep, StringFormat='粗层位置步长：{0} px（1 最彻底）'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="8" Value="{Binding PrecisionStep}" TickFrequency="1"/>
                                <TextBlock Text="{Binding CoarseAcceptThreshold, StringFormat='粗层接受阈值：{0:F2}'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="0.1" Maximum="0.9" Value="{Binding CoarseAcceptThreshold}" TickFrequency="0.01"/>
                                <TextBlock Text="{Binding MaxCandidates, StringFormat='候选假设数：{0}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="4" Maximum="64" Value="{Binding MaxCandidates}" TickFrequency="4"/>
                                <TextBlock Text="{Binding TrainFeatureFloor, StringFormat='训练边缘门限：{0:F2}（占最强边比例）'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="0.6" Value="{Binding TrainFeatureFloor}" TickFrequency="0.02"/>
                                <CheckBox Content="特征间距自动（跟随粒度）" IsChecked="{Binding TrainMinSpacingAuto}"
                                          ToolTip="PatMax 没有间距参数，特征密度由 GrainLimitFine/Coarse 决定；自动即 2×粒度"/>
                                <TextBlock Text="{Binding SpacingSummary}" Style="{StaticResource value}"/>
                                <TextBlock Text="{Binding TrainMinSpacing, StringFormat='手动间距：{0:F1} px'}"
                                           Style="{StaticResource lbl}"/>
                                <Slider Minimum="1" Maximum="8" Value="{Binding TrainMinSpacing}" TickFrequency="0.5"
                                        IsEnabled="{Binding TrainMinSpacingAuto, Converter={StaticResource InverseBool}}"/>
                                <TextBlock Text="{Binding ClusterRadius, StringFormat='聚类半径：{0:F0} px'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="2" Maximum="40" Value="{Binding ClusterRadius}" TickFrequency="2"/>
                                <TextBlock Text="{Binding PreSmoothSigma, StringFormat='高斯预平滑 σ：{0:F1}'}" Style="{StaticResource lbl}"/>
                                <Slider Minimum="0" Maximum="3" Value="{Binding PreSmoothSigma}" TickFrequency="0.1"/>
                                <CheckBox Content="SIMD 加速" IsChecked="{Binding UseSimd}"/>
                                <CheckBox Content="并行处理" IsChecked="{Binding UseParallel}"/>
                                <TextBlock Style="{StaticResource hint}"
                                           Text="亚像素细化与候选聚类固定开启（关闭只会变差，故不显示）。"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="6. 参数预设">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          DisplayMemberPath="Name" ToolTip="{Binding SelectedPreset.Description}"/>
                                <TextBlock Text="{Binding SelectedPreset.Description}" Style="{StaticResource hint}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="应用" Click="ApplyPreset_Click"/>
                                    <Button Content="新建" Command="{Binding NewPresetCommand}"/>
                                    <Button Content="保存" Command="{Binding SavePresetCommand}"/>
                                    <Button Content="删除" Command="{Binding DeletePresetCommand}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource hint}" Margin="2,6,2,0"
                                           Text="预设保存在本机 AppData，重启后自动加载。"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

            <!-- ===== Image + results ===== -->
            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="230" MinHeight="110"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0E0E10" BorderBrush="{StaticResource BBorder}"
                        BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <Grid>
                        <c:ImageRegionSelector x:Name="viewer" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Source="{Binding Image}"
                            TrainRegion="{Binding TrainRegion, Mode=TwoWay}"
                            SearchRegion="{Binding SearchRegion, Mode=TwoWay}"
                            Markers="{Binding Markers}"
                            PatternOutline="{Binding PatternOutline}"
                            OriginPoint="{Binding OriginPoint}"
                            MaskBytes="{Binding Mask}"
                            BrushRadius="{Binding BrushRadius}"
                            MaskErase="{Binding MaskErase}"
                            ShowTrainRegion="{Binding ShowTrainRegion}"
                            ImageWidth="{Binding ImagePixelWidth}"
                            ImageHeight="{Binding ImagePixelHeight}"/>
                        <Border Background="#CC1B1B1D" Visibility="{Binding ShowCanvasHint, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="① 打开图片　② 在图上拖出训练区　③ 训练模型　④ 运行匹配"
                                           Foreground="#C8C8D0" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="快捷键  Ctrl+O / Ctrl+T / F5"
                                           Foreground="#7A7A84" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Height="6" Background="#3E3E45" ShowsPreview="False"/>

                <Border Grid.Row="2" Background="{StaticResource BPanel}" BorderBrush="{StaticResource BBorder}"
                        BorderThickness="1" CornerRadius="3">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource BControl}" Padding="8,5"
                                BorderBrush="{StaticResource BBorder}" BorderThickness="0,0,0,1">
                            <TextBlock Text="匹配结果" Foreground="{StaticResource BText}" FontWeight="SemiBold"/>
                        </Border>
                        <DataGrid x:Name="resultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                                  SelectedItem="{Binding SelectedResult}" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  BorderThickness="0" RowHeight="24">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#33333A"/>
                                    <Setter Property="Foreground" Value="#D8D8E0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="BorderBrush" Value="#44444C"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="40"
                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}"/>
                                <DataGridTextColumn Header="图像" Binding="{Binding ModelId}" Width="110"/>
                                <DataGridTextColumn Header="得分" Binding="{Binding Score, StringFormat=F3}" Width="70"/>
                                <DataGridTextColumn Header="覆盖率" Binding="{Binding Coverage, StringFormat=P0}" Width="70"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}" Width="70"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}" Width="70"/>
                                <DataGridTextColumn Header="角度°" Binding="{Binding AngleDegrees, StringFormat=F2}" Width="70"/>
                                <DataGridTextColumn Header="缩放" Binding="{Binding Scale, StringFormat=F3}" Width="70"/>
                                <DataGridTextColumn Header="匹配特征" Binding="{Binding MatchedFeatures}" Width="80"/>
                                <DataGridTextColumn Header="杂波特征" Binding="{Binding BadFeatures}" Width="80"/>
                                <DataGridTextColumn Header="杂波比" Binding="{Binding Clutter, StringFormat=P0}" Width="70"/>
                                <DataGridTextColumn Header="拟合误差" Binding="{Binding FitError, StringFormat=F2}" Width="80"/>
                                <DataGridCheckBoxColumn Header="接受" Binding="{Binding Accepted}" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
